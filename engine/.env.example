# Copier ce fichier en .env et remplir les vraies valeurs.
# Ne JAMAIS committer .env (voir .gitignore).

# football-data.org — clé gratuite sur https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# The Odds API (optionnel, pour comparer aux cotes marché) — https://the-odds-api.com/
ODDS_API_KEY=

# Sofascore via RapidAPI — https://rapidapi.com/apidojo/api/sofascore
SOFASCORE_RAPIDAPI_KEY=
SOFASCORE_RAPIDAPI_HOST=sofascore.p.rapidapi.com

# Supabase (uniquement si/quand le panneau admin est branché)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clé service_role : jamais utilisée côté client, jamais loggée
SUPABASE_SERVICE_ROLE_KEY=
